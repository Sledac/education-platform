{
    "labs": {
        "lab1-basics": {
            "title": "Знакомство с кластером",
            "estimated_time": 15,
            "tasks": [
                {
                    "id": "count-nodes",
                    "title": "Количество нод",
                    "description": "Выполните команду kubectl get nodes в текущем namespace",
                    "validation": {
                        "type": "node-count",
                        "expected":"1"
                    }
                },
                {
                    "id": "check-pods",
                    "title": "Колличество подов",
                    "description": "Выполните команду kubectl get pods в текущем namespace",
                    "validation": {
                        "type": "pod-count",
                        "expected": "0"
                    }
                },
                {
                    "id": "count-pods-nginx",
                    "title": "Колличество nginx подов ",
                    "description": "",
                    "setup": {
                        "namespace": "default",
                        "pods":[
                        {
                            "name": "nginx", 
                             "image": "nginx:alpine"
                        }
                        ]
                    },
                    "validation": {
                        "type": "pod-count",
                        "expected": "1"
                    }
                }
            ]
        }
    }
}